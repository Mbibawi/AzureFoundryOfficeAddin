<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- ── IDENTITY ── -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Foundry AI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <!-- ── DISPLAY ── -->
  <DisplayName DefaultValue="Foundry AI" />
  <Description DefaultValue="Access all your Azure AI Foundry models (Claude, GPT, Llama, Mistral, and more) directly in Word." />

  <!-- Icons — replace with your own hosted PNGs -->
  <IconUrl         DefaultValue="https://REPLACE_WITH_YOUR_HOST/assets/icon-80.png" />
  <HighResolutionIconUrl DefaultValue="https://REPLACE_WITH_YOUR_HOST/assets/icon-80.png" />
  <SupportUrl      DefaultValue="https://REPLACE_WITH_YOUR_HOST" />

  <!-- ── ALLOWED DOMAINS ── -->
  <AppDomains>
    <!-- Azure AI Foundry — required for API calls from the task pane -->
    <AppDomain>https://*.services.ai.azure.com</AppDomain>
    <!-- Your hosting domain — replace with your actual domain -->
    <AppDomain>https://REPLACE_WITH_YOUR_HOST</AppDomain>
    <!-- For local dev -->
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <!-- ── HOSTS ── -->
  <Hosts>
    <Host Name="Document" />
    <Host Name="Workbook" />
    <Host Name="Presentation" />
  </Hosts>

  <!-- ── REQUIREMENTS ── -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- ── DEFAULT SETTINGS ── -->
  <DefaultSettings>
    <!-- For production: change to your hosted URL -->
    <!-- For local dev:  use https://localhost:3000/taskpane.html -->
    <SourceLocation DefaultValue="https://REPLACE_WITH_YOUR_HOST/taskpane.html" />
  </DefaultSettings>

  <!-- ── PERMISSIONS ── -->
  <!-- ReadWriteDocument allows reading the full document text -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- ── VERSION OVERRIDES (ribbon button) ── -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="FoundryAI.Group">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="FoundryAI.TaskPaneButton">
                  <Label resid="TaskPaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskPaneButton.Label" />
                    <Description resid="TaskPaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>FoundryAI</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="FoundryAI.Group">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="FoundryAI.TaskPaneButton">
                  <Label resid="TaskPaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskPaneButton.Label" />
                    <Description resid="TaskPaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>FoundryAI</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="FoundryAI.Group">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="FoundryAI.TaskPaneButton">
                  <Label resid="TaskPaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskPaneButton.Label" />
                    <Description resid="TaskPaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>FoundryAI</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- ── RESOURCES ── -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://REPLACE_WITH_YOUR_HOST/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://REPLACE_WITH_YOUR_HOST/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://REPLACE_WITH_YOUR_HOST/assets/icon-80.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl"   DefaultValue="https://REPLACE_WITH_YOUR_HOST" />
        <bt:Url id="Taskpane.Url"              DefaultValue="https://REPLACE_WITH_YOUR_HOST/taskpane.html" />
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GetStarted.Title"        DefaultValue="Foundry AI is ready!" />
        <bt:String id="CommandsGroup.Label"     DefaultValue="Foundry AI" />
        <bt:String id="TaskPaneButton.Label"    DefaultValue="Open Foundry AI" />
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="GetStarted.Description"    DefaultValue="Open the Foundry AI panel to analyse your document with any Azure AI Foundry model." />
        <bt:String id="TaskPaneButton.Tooltip"    DefaultValue="Open the Foundry AI task pane to use Claude, GPT, Llama and more on your document." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>
